# Required
OWNER_PASSWORD=choose-a-long-password
# Postgres (recommended in production). Without it, a local SQLite file in ./data is used.
DATABASE_URL=

# Optional: Devin API (server-side only). Without these, the app shows "Copy brief".
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEFAULT_ACU_LIMIT=10
MAX_ACU_LIMIT=50

# Optional: research provider. Set one of these, or leave both empty for manual research.
TAVILY_API_KEY=
# RESEARCH_PROVIDER=public   # keyless: GDELT news, company feeds/sitemaps, HN, public job boards, SEC EDGAR
ACU_PRICE_USD=2.25            # $ per ACU used for the cost line in the prospect PDF
REPORT_CONTACT=              # optional contact line printed in the prospect PDF, e.g. "Jordan Lee, jordan@example.com"
CONTACT_EMAIL=               # sent in the research User-Agent (SEC EDGAR asks for one)

# Optional: OpenAI-compatible model to summarize fetched sources (excerpts are still verified verbatim)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
